{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/L1ghtn1ng/traceguard/docs/policy.schema.json",
  "title": "TraceGuard policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "builtin_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"const": "baseline"}
    },
    "disabled_rule_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rule_id"}
    },
    "dns": {"$ref": "#/$defs/dns"},
    "egress": {"$ref": "#/$defs/egress"},
    "exec": {"$ref": "#/$defs/path_policy"},
    "file": {"$ref": "#/$defs/file_policy"},
    "bind": {"$ref": "#/$defs/bind_policy"},
    "unix": {"$ref": "#/$defs/unix_policy"},
    "sockopt": {"$ref": "#/$defs/sockopt_policy"},
    "detections": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/detection"}
    },
    "detection_exceptions": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/detection_exception"}
    }
  },
  "$defs": {
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "string_list": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string"}
    },
    "unique_string_list": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "dns_list": {
      "type": "array",
      "maxItems": 4096,
      "description": "The parser limits dns.block and dns.allow to 4096 entries combined, and the merged remote plus local policy to 4096 DNS rules.",
      "items": {"type": "string"}
    },
    "uid_list": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "port_list": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 65535}
    },
    "rule_port_list": {
      "description": "Egress and bind ports. Port 0 is rejected because it is the kernel wildcard; omit ports to match any port.",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 65535}
    },
    "duration": {
      "type": "string",
      "pattern": "^(0|([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+)$"
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": {"$ref": "#/$defs/dns_list"},
        "allow": {"$ref": "#/$defs/dns_list"}
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"enum": ["allow", "block"]},
        "rules": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/egress_rule"}
        }
      }
    },
    "egress_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "action": {"enum": ["allow", "block"]},
        "selectors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uids": {"$ref": "#/$defs/uid_list"},
            "cgroup_paths": {"$ref": "#/$defs/unique_string_list"},
            "cgroup_prefixes": {"$ref": "#/$defs/unique_string_list"}
          }
        },
        "destinations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {"$ref": "#/$defs/unique_string_list"},
            "ports": {"$ref": "#/$defs/rule_port_list"},
            "protocols": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["tcp", "udp"]}
            }
          }
        }
      }
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uids": {"$ref": "#/$defs/uid_list"},
        "cgroup_paths": {"$ref": "#/$defs/unique_string_list"},
        "cgroup_prefixes": {"$ref": "#/$defs/unique_string_list"}
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidrs": {"$ref": "#/$defs/unique_string_list"},
        "ports": {"$ref": "#/$defs/rule_port_list"},
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["tcp", "udp"]}
        }
      }
    },
    "path_globs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 243}
    },
    "path_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"const": "allow"},
        "rules": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/path_rule"}
        }
      }
    },
    "path_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "match"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "action": {"enum": ["allow", "block"]},
        "selectors": {"$ref": "#/$defs/selectors"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_globs"],
          "properties": {"path_globs": {"$ref": "#/$defs/path_globs"}}
        }
      }
    },
    "file_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"const": "allow"},
        "rules": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/file_rule"}
        }
      }
    },
    "file_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "match"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "action": {"enum": ["allow", "block"]},
        "selectors": {"$ref": "#/$defs/selectors"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_globs"],
          "properties": {
            "path_globs": {"$ref": "#/$defs/path_globs"},
            "access": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "write"]}}
          }
        }
      }
    },
    "bind_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"enum": ["allow", "block"]},
        "rules": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/bind_rule"}}
      }
    },
    "bind_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "action": {"enum": ["allow", "block"]},
        "selectors": {"$ref": "#/$defs/selectors"},
        "endpoints": {"$ref": "#/$defs/endpoints"}
      }
    },
    "unix_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"enum": ["allow", "block"]},
        "rules": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/unix_rule"}}
      }
    },
    "unix_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "match"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "action": {"enum": ["allow", "block"]},
        "selectors": {"$ref": "#/$defs/selectors"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_globs"],
          "properties": {
            "path_globs": {"$ref": "#/$defs/path_globs"},
            "operations": {"type": "array", "uniqueItems": true, "items": {"enum": ["connect", "sendmsg", "recvmsg"]}}
          }
        }
      }
    },
    "sockopt_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {"enum": ["allow", "block"]},
        "rules": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/sockopt_rule"}}
      }
    },
    "sockopt_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "match"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "action": {"enum": ["allow", "block"]},
        "selectors": {"$ref": "#/$defs/selectors"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["levels", "optnames"],
          "properties": {
            "levels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["socket", "sol_socket", "ip", "sol_ip", "ipv6", "sol_ipv6"]}},
            "optnames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["so_mark", "so_reuseport", "ip_transparent", "ipv6_transparent"]}}
          }
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {"enabled": {"const": false}},
              "required": ["enabled"]
            }
          },
          "then": {"required": ["severity", "events", "message"]}
        }
      ],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "enabled": {"type": "boolean"},
        "severity": {
          "enum": ["debug", "informational", "notice", "warning", "error", "critical", "alert", "emergency"]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["dns", "blocked", "exec", "resolver", "resolver_blocked", "connection", "file_access", "file_created", "egress_blocked", "egress_would_block", "exec_blocked", "exec_would_block", "file_blocked", "file_would_block", "bind_blocked", "bind_would_block", "unix_blocked", "unix_would_block", "sockopt_blocked", "sockopt_would_block", "tcp_sockops", "memfd_create", "ptrace", "process_vm", "module_load", "bpf_prog_load", "io_uring_setup", "mount", "namespace_change", "privilege_change"]
          }
        },
        "match": {"$ref": "#/$defs/detection_match"},
        "exclude": {"$ref": "#/$defs/detection_match"},
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "if": {"required": ["count"], "properties": {"count": {"minimum": 2}}},
          "then": {
            "required": ["within", "group_by"],
            "properties": {
              "within": {
                "description": "Required and positive when count exceeds 1; the parser also caps it at 1h.",
                "not": {"pattern": "^(0|(0+(\\.0+)?(ns|us|µs|ms|s|m|h))+)$"}
              },
              "group_by": {"minItems": 1}
            }
          },
          "properties": {
            "count": {"type": "integer", "minimum": 0, "maximum": 10000, "description": "0 or omitted is treated as 1."},
            "within": {"$ref": "#/$defs/duration"},
            "group_by": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "description": "Process-identity fields require contemporaneous identity on every selected event; DNS, blocked DNS, sockops, and inbound TCP connection cache attribution are not eligible.",
              "items": {
                "enum": ["cgroup", "executable", "program", "uid", "domain", "destination", "peer", "path"]
              }
            }
          }
        },
        "cooldown": {"$ref": "#/$defs/duration"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "tags": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 64}
        }
      }
    },
    "detection_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rules", "reason", "match"],
      "properties": {
        "id": {"$ref": "#/$defs/rule_id"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/rule_id"}
        },
        "reason": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
        "expires": {"type": "string", "format": "date-time"},
        "match": {"allOf": [{"$ref": "#/$defs/detection_match"}, {"minProperties": 1}]}
      }
    },
    "detection_match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {"$ref": "#/$defs/string_list"},
        "directions": {"type": "array", "items": {"enum": ["inbound", "outbound"]}},
        "transports": {"$ref": "#/$defs/string_list"},
        "protocols": {"type": "array", "items": {"enum": ["tcp", "udp"]}},
        "uids": {
          "$ref": "#/$defs/uid_list",
          "description": "Requires contemporaneous event-time identity; unavailable for DNS, blocked DNS, sockops, and inbound TCP connection cache attribution."
        },
        "domains": {"$ref": "#/$defs/string_list"},
        "domain_suffixes": {"$ref": "#/$defs/string_list"},
        "destination_cidrs": {"$ref": "#/$defs/string_list"},
        "ports": {"$ref": "#/$defs/port_list", "description": "Peer port; for inbound connections this is the remote source port."},
        "local_ports": {
          "$ref": "#/$defs/port_list",
          "description": "Local port; valid only with connection, egress, bind, and tcp_sockops events."
        },
        "executable_globs": {"$ref": "#/$defs/string_list"},
        "file_path_globs": {"$ref": "#/$defs/string_list"},
        "unix_path_globs": {
          "$ref": "#/$defs/string_list",
          "description": "Requested AF_UNIX socket paths: exact absolute or @abstract names, or /** subtrees; valid only with unix_blocked and unix_would_block."
        },
        "file_access": {"type": "array", "items": {"enum": ["read", "write", "unknown"]}},
        "operations": {
          "type": "array",
          "maxItems": 256,
          "items": {"enum": ["traceme", "poketext", "pokedata", "pokeuser", "attach", "seize", "read", "write", "init_module", "finit_module", "setns", "unshare", "setuid", "setgid", "setreuid", "setregid", "setresuid", "setresgid", "capset"]},
          "description": "Security event operation; valid only with ptrace, process_vm, module_load, namespace_change, and privilege_change events."
        }
      }
    }
  }
}
