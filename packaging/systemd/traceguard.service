[Unit]
Description=TraceGuard eBPF runtime policy and detection monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/traceguard/traceguard.env
ExecStart=/usr/bin/traceguard
Restart=on-failure
RestartSec=5s
StateDirectory=traceguard
LogsDirectory=traceguard
LogsDirectoryMode=0750
WorkingDirectory=/var/lib/traceguard
User=root
Group=root
UMask=0027
LimitNOFILE=16384
# CAP_SYS_PTRACE is deliberately omitted (least privilege). Without it,
# readlink(/proc/<pid>/exe) fails for processes owned by other users, so the
# current_exe and current_parent_exe enrichment fields are empty for them.
# Operators who accept the extra privilege may add CAP_SYS_PTRACE to both
# capability sets below to restore full executable-path enrichment.
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=-/sys/fs/bpf /var/lib/traceguard /var/log/traceguard
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
