# TraceGuard environment configuration.
# Leave TRACEGUARD_BLOCK=false for observe-only mode.

# Policy
# TRACEGUARD_BLOCK_DOMAINS and TRACEGUARD_ALLOW_DOMAINS accept comma/newline-separated
# values or @/abs/path to load entries from a file. Use * as the deny-all marker.

TRACEGUARD_BLOCK=false
TRACEGUARD_DRY_RUN=false
TRACEGUARD_BLOCKLIST_URL=
TRACEGUARD_BLOCK_DOMAINS=
TRACEGUARD_ALLOW_DOMAINS=
TRACEGUARD_CACHE_PATH=/var/lib/traceguard/blocklist.txt
TRACEGUARD_REFRESH_INTERVAL=6h
TRACEGUARD_CGROUP_PATH=/sys/fs/cgroup

# Logging and metrics
# Default is JSON. Set to text if you need the legacy human-readable format.
TRACEGUARD_LOG_PATH=/var/log/traceguard/traceguard.log
TRACEGUARD_LOG_FORMAT=json
TRACEGUARD_METRICS_ADDR=:9091

# Local event archive
# Disabled by default. Set this to keep a JSONL copy of every structured event.
TRACEGUARD_EVENT_ARCHIVE_PATH=

# Durable HTTPS event export
# Use this when a SIEM, data lake, webhook collector, or other remote service
# should receive structured TraceGuard events reliably.
#
# Required to enable:
#   Set TRACEGUARD_EVENT_EXPORT_URL to an HTTPS endpoint that accepts POSTed JSON
#   arrays of event records. Leave it empty to disable HTTPS export.
TRACEGUARD_EVENT_EXPORT_URL=

# Common collector settings
TRACEGUARD_EVENT_EXPORT_AUTHORIZATION=

# Durable retry spool
# Failed batches are written to /var/lib/traceguard/export-spool and replayed
# later. Spooling is capped at 1 MiB per batch and 256 MiB total. Set this
# false to rely only on the in-memory queue.
TRACEGUARD_EVENT_EXPORT_SPOOL=true

# TLS and mTLS
# Leave CA/cert/key empty to use the system trust store without client auth.
TRACEGUARD_EVENT_EXPORT_CA_PATH=
TRACEGUARD_EVENT_EXPORT_CLIENT_CERT=
TRACEGUARD_EVENT_EXPORT_CLIENT_KEY=

# Remote syslog event export
# Disabled by default. Set TRACEGUARD_EVENT_SYSLOG_URL to one of:
#   syslog+udp://host:514
#   syslog+tcp://host:514
#   syslog+tls://host:6514
# Syslog export is best-effort. Use HTTPS export when durable retry spooling is required.
TRACEGUARD_EVENT_SYSLOG_URL=
TRACEGUARD_EVENT_SYSLOG_FACILITY=local0
TRACEGUARD_EVENT_SYSLOG_TAG=traceguard
TRACEGUARD_EVENT_SYSLOG_TIMEOUT=5s
TRACEGUARD_EVENT_SYSLOG_CA_PATH=

# Process enrichment and auditing
TRACEGUARD_PROCESS_CACHE_TTL=5m
TRACEGUARD_FILE_AUDIT=true

# Kubernetes enrichment
# Disabled by default. When enabled inside a cluster, TraceGuard can auto-detect
# the API URL from service env vars and uses the standard service-account token
# and CA paths below. Set TRACEGUARD_KUBERNETES_NODE_NAME explicitly, or provide
# NODE_NAME via the Kubernetes downward API, to scope pod listing to this node.
TRACEGUARD_KUBERNETES_ENRICH=false
TRACEGUARD_KUBERNETES_API_URL=
TRACEGUARD_KUBERNETES_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
TRACEGUARD_KUBERNETES_CA_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
TRACEGUARD_KUBERNETES_NODE_NAME=
TRACEGUARD_KUBERNETES_POLL_INTERVAL=2m
